# --- Model provider -------------------------------------------------------
# One of: bedrock | anthropic | openai | ollama
HION_MODEL_PROVIDER=bedrock
HION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
HION_AWS_REGION=us-west-2
# HION_MODEL_API_KEY=sk-ant-...            # anthropic / openai
# HION_MODEL_BASE_URL=http://localhost:11434  # ollama

# --- Orchestration --------------------------------------------------------
HION_MAX_REVISIONS=2
HION_MAX_CONCURRENCY=3
# Risk at or below this level runs without human approval: LOW | MEDIUM | HIGH
HION_AUTO_APPROVE_MAX_RISK=MEDIUM
# What to do when the Critic still rejects after HION_MAX_REVISIONS: accept | fail
HION_ON_REVISIONS_EXHAUSTED=accept
HION_APPROVAL_TIMEOUT_SECONDS=900

# --- Tools ----------------------------------------------------------------
HION_WORKSPACE_DIR=./workspace
# Search backend: auto | tavily | duckduckgo | none
HION_SEARCH_PROVIDER=auto
# HION_TAVILY_API_KEY=tvly-...
# Real destination for HIGH-risk external publishing. Unset => publishing fails
# loudly instead of pretending to have happened.
# HION_EXTERNAL_WEBHOOK_URL=https://example.com/hook
