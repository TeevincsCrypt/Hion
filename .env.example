# Hion configuration. Copy to .env and fill in. Never commit .env.
# Every value is optional unless noted; the defaults are shown.

# =============================================================================
# Model provider (required: one of the two options below)
# =============================================================================
# auto     - prefer Amazon Bedrock when AWS credentials are present in the
#            environment, otherwise fall back to an API-key provider (default)
# bedrock | anthropic | openai | ollama - pin one explicitly
HION_MODEL_PROVIDER=auto

# Leave HION_MODEL_ID unset to use each provider's default:
#   bedrock   us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   anthropic claude-sonnet-4-5-20250929
#   openai    gpt-4o
#   ollama    llama3.1
# HION_MODEL_ID=

# --- Option 1: Amazon Bedrock (preferred when credentials already exist) -----
# Credentials come from the standard AWS chain: environment variables, a shared
# profile (AWS_PROFILE), or an instance/task role. Hion reads no AWS settings of
# its own beyond the region, and stores no credentials.
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_SESSION_TOKEN=...          # only for temporary credentials
# The model must be enabled for your account in the Bedrock console
# (Model access) in this region.
HION_AWS_REGION=us-west-2

# --- Option 2: an API-key provider ------------------------------------------
# Set the key here and pin the provider above (anthropic or openai).
# HION_MODEL_PROVIDER=anthropic
# HION_MODEL_API_KEY=sk-ant-...
# HION_MODEL_PROVIDER=openai
# HION_MODEL_API_KEY=sk-...
# Optional override for a gateway or self-hosted endpoint:
# HION_MODEL_BASE_URL=

# --- Option 3: local Ollama --------------------------------------------------
# HION_MODEL_PROVIDER=ollama
# HION_MODEL_BASE_URL=http://localhost:11434

HION_MAX_TOKENS=8192
HION_TEMPERATURE=0.3

# Verify the provider actually answers before running a mission:
#   hion doctor

# =============================================================================
# Orchestration
# =============================================================================
# How many times a specialist may revise after a Critic rejection.
HION_MAX_REVISIONS=2
# What to do when the Critic still rejects after that: fail | accept
# "fail" ends the task with an explanation rather than shipping rejected work.
HION_ON_REVISIONS_EXHAUSTED=fail
# How many ready tasks may run at once.
HION_MAX_CONCURRENCY=3
# Risk at or below this level runs without a human: LOW | MEDIUM | HIGH
# HIGH always requires a human regardless of this setting.
HION_AUTO_APPROVE_MAX_RISK=MEDIUM
# How long a mission waits for a human decision before giving up.
HION_APPROVAL_TIMEOUT_SECONDS=900

# =============================================================================
# Critic calibration
# =============================================================================
# An "approved" verdict below this overall score is overridden to a rejection.
HION_CRITIC_APPROVAL_THRESHOLD=75
# Any single dimension below this also blocks approval, so a strong average
# cannot hide a failing axis such as fabricated claims.
HION_CRITIC_MIN_DIMENSION_SCORE=60

# =============================================================================
# Tools
# =============================================================================
HION_WORKSPACE_DIR=./workspace
# Search backend: auto (Tavily if keyed, else DuckDuckGo) | tavily | duckduckgo | none
HION_SEARCH_PROVIDER=auto
# HION_TAVILY_API_KEY=tvly-...
HION_HTTP_TIMEOUT_SECONDS=20
HION_MAX_FETCH_CHARS=12000

# Real destination for HIGH-risk external publishing. Left unset, publishing
# fails loudly instead of pretending to have happened.
# HION_EXTERNAL_WEBHOOK_URL=https://example.com/hook
